<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_move_form_l10n_ar_remito" model="ir.ui.view">
            <field name="name">account.move.form.l10n.ar.remito</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">

                    <page string="Remitos"
                          name="l10n_ar_remitos"
                          invisible="move_type not in ('out_invoice', 'out_refund')">

                        <field name="l10n_ar_remito_ids"
                               nolabel="1"
                               readonly="1">

                            <list>

                                <field name="name"
                                       string="N.º de Remito"/>

                                <field name="partner_id"
                                       string="Cliente"/>

                                <field name="l10n_ar_document_type_id"
                                       string="Tipo de documento"/>

                                <field name="l10n_ar_cai_authorization_code"
                                       string="CAI"/>

                                <field name="l10n_ar_cai_expiration_date"
                                       string="Vencimiento CAI"/>

                            </list>

                        </field>

                    </page>

                </xpath>

            </field>
        </record>

    </data>
</odoo>